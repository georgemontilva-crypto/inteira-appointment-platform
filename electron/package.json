{
  "name": "inteira-desktop",
  "version": "1.0.0",
  "description": "Inteira Desktop App",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "icons:generate": "node scripts/generate-icons.cjs"
  },
  "build": {
    "appId": "app.inteira.desktop",
    "productName": "Inteira",
    "directories": { "output": "dist" },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "icons/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "files": ["main.cjs", "preload.cjs", "icons/"]
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0",
    "sharp": "^0.34.5"
  }
}
